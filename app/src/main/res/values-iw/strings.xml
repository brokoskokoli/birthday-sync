    <string name="check_exact_alarm_title">שעונים מעוררים ותזכורות מדויקים</string>
    <string name="check_exact_alarm_desc">כדי שההתראה היומית תגיע בדיוק בשעה שהוגדרה. בלי ההרשאה הזו היא עלולה להתעכב מעט.</string>
    <string name="check_battery_title">השבתת אופטימיזציית הסוללה</string>
    <string name="check_battery_desc">מונע מ-Android לדחות או לחסום את הסנכרון ברקע.</string>
    <string name="check_background_title">פעילות ברקע מותרת</string>
    <string name="check_background_desc">אסור שהאפליקציה תהיה מוגבלת ברקע (פרטי האפליקציה ← סוללה ← “ללא הגבלה”).</string>
    <string name="check_hibernation_title">השהיית האפליקציה כשאין בה שימוש כבויה</string>
    <string name="check_hibernation_desc">אחרת Android יבטל את ההרשאות אחרי כמה חודשים שבהם האפליקציה לא נפתחה, והסנכרון ייפסק.</string>
    <string name="check_power_save_title">חיסכון בסוללה</string>
    <string name="check_power_save_on">מצב “חיסכון בסוללה” פועל ועלול לעכב סנכרונים.</string>
    <string name="check_power_save_off">מצב “חיסכון בסוללה” כבוי.</string>
    <string name="check_vendor_title">ניהול הסוללה של היצרן (%1$s)</string>
    <string name="check_vendor_desc">היצרן הזה נוהג לעצור אפליקציות ברקע גם בנוסף. יש לאשר הפעלה אוטומטית או “המשך פעולה ברקע” עבור Birthday Sync. לא ניתן לבדוק זאת באופן אוטומטי.</string>

