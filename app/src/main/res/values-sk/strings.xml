    <string name="check_vendor_desc">Tento výrobca navyše často ukončuje aplikácie na pozadí. Povoľ pre Birthday Sync automatické spúšťanie alebo „Ponechať aktívne na pozadí“. Tento stav sa nedá automaticky overiť.</string>

    <plurals name="onboarding_step">
        <item quantity="one">Krok %1$d z %2$d</item>
        <item quantity="few">Krok %1$d z %2$d</item>
