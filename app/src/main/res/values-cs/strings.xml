    <string name="check_vendor_desc">Tento výrobce navíc často ukončuje aplikace na pozadí. Povol pro Birthday Sync automatické spouštění nebo „Ponechat aktivní na pozadí“. Tento stav nelze automaticky ověřit.</string>

    <plurals name="onboarding_step">
        <item quantity="one">Krok %1$d z %2$d</item>
        <item quantity="few">Krok %1$d z %2$d</item>
