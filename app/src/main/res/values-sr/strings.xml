    <string name="check_vendor_title">Управљање батеријом произвођача (%1$s)</string>
    <string name="check_vendor_desc">Овај произвођач често додатно гаси апликације у позадини. Дозволи аутоматско покретање или „Рад у позадини“ за Birthday Sync. То не може аутоматски да се провери.</string>

    <plurals name="onboarding_step">
        <item quantity="one">Корак %1$d од %2$d</item>
