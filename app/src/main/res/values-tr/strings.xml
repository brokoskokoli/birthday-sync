    <string name="check_vendor_desc">Bu üretici arka plandaki uygulamaları ayrıca sık sık kapatır. Lütfen Birthday Sync için otomatik başlatmaya veya “Arka planda çalışmaya devam et” seçeneğine izin verin. Bu durum otomatik olarak kontrol edilemez.</string>

    <plurals name="onboarding_step">
        <item quantity="one">Adım %1$d/%2$d</item>
        <item quantity="other">Adım %1$d/%2$d</item>
