    <string name="check_hibernation_title">Pausa per inactivitat desactivada</string>
    <string name="check_hibernation_desc">Si no, Android retira els permisos després d\'uns quants mesos sense obrir l\'aplicació i la sincronització s\'atura.</string>
    <string name="check_power_save_title">Estalvi de bateria</string>
