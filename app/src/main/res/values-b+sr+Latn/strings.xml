    <string name="check_vendor_title">Upravljanje baterijom proizvođača (%1$s)</string>
    <string name="check_vendor_desc">Ovaj proizvođač često dodatno gasi aplikacije u pozadini. Dozvoli automatsko pokretanje ili „Rad u pozadini“ za Birthday Sync. To ne može automatski da se proveri.</string>

    <plurals name="onboarding_step">
        <item quantity="one">Korak %1$d od %2$d</item>
        <item quantity="few">Korak %1$d od %2$d</item>
