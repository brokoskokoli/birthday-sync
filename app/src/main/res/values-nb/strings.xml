    <plurals name="onboarding_step">
        <item quantity="one">Steg %1$d av %2$d</item>
        <item quantity="other">Steg %1$d av %2$d</item>
    </plurals>
    <string name="onboarding_welcome_title">Velkommen til Birthday Sync</string>
    <string name="onboarding_welcome_text">Appen overfører automatisk bursdagene fra kontaktene dine til en kalender du velger, og minner deg på dem på selve dagen.\n\nFor at dette skal fungere pålitelig i bakgrunnen, trenger appen noen tillatelser. Vi går gjennom dem steg for steg og forklarer hva hver av dem trengs til.\n\nAlt blir værende på enheten din – appen har ikke internettilgang.</string>
    <string name="onboarding_contacts_title">Tilgang til kontaktene dine</string>
    <string name="onboarding_contacts_text">Bursdagene er lagret i kontaktene dine. For at appen skal finne dem, trenger den lesetilgang.\n\nBare navn, bursdager og tilknytningen til kontoer og grupper leses, også i bakgrunnen ved den jevnlige synkroniseringen. Dataene blir værende på enheten: Appen endrer ingen kontakter, har ikke internettilgang og deler ingenting.</string>
    <string name="onboarding_calendar_title">Tilgang til kalenderen din</string>
    <string name="onboarding_calendar_text">For hver bursdag oppretter appen en hendelse i en kalender du velger, og holder den oppdatert, for eksempel hvis en fødselsdato endres.\n\nDerfor må den kunne lese og skrive i kalendere. Bare appens egne bursdagshendelser blir noensinne endret.</string>
    <string name="onboarding_notifications_title">Varsler</string>
    <string name="onboarding_notifications_text">Hvis du vil, gir appen beskjed på et fast klokkeslett når noen har bursdag i dag.\n\nUten denne tillatelsen forblir varselet stille.</string>
    <string name="onboarding_exact_alarm_title">Påminnelse i tide</string>
    <string name="onboarding_exact_alarm_text">For at det daglige varselet skal komme nøyaktig på det innstilte klokkeslettet og ikke en gang senere, trenger appen tillatelse til alarmer og påminnelser.\n\nSlå på bryteren for Birthday Sync på neste skjerm, og gå deretter tilbake hit med «Tilbake».</string>
    <string name="onboarding_battery_title">Arbeide i bakgrunnen</string>
    <string name="onboarding_battery_text">Android setter gjerne apper i bakgrunnen i dvale for å spare batteri. Da kan den jevnlige synkroniseringen utebli.\n\nSynkroniseringen tar bare noen sekunder om dagen, og det ekstra batteriforbruket er knapt målbart. Velg «Alle apper» i listen som kommer, deretter Birthday Sync, og velg «Ikke optimaliser».</string>
    <string name="onboarding_background_title">Opphev bakgrunnsbegrensningen</string>
    <string name="onboarding_background_text">Bakgrunnsaktiviteten er begrenset for denne appen, så synkroniseringen og varselet uteblir.\n\nÅpne «Batteri» i Appinfo, og velg «Ubegrenset». Gå deretter tilbake hit med «Tilbake».</string>
    <string name="onboarding_hibernation_title">Ikke sett på pause automatisk</string>
    <string name="onboarding_hibernation_text">Hvis du ikke åpner appen på noen måneder, setter Android den på pause og fjerner tillatelsene. Synkroniseringen ville da stoppe uten at du merker det – selv om appen nettopp skal arbeide i bakgrunnen.\n\nSlå av «Sett appaktivitet på pause hvis den ikke brukes» på neste skjerm, og gå deretter tilbake hit med «Tilbake».</string>
