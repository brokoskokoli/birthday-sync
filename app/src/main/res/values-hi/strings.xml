    <string name="check_calendar_title">कैलेंडर पढ़ना और उसमें लिखना</string>
    <string name="check_calendar_desc">टारगेट कैलेंडर में जन्मदिन के इवेंट बनाने और उन्हें अप-टू-डेट रखने के लिए ज़रूरी है.</string>
    <string name="check_notifications_title">सूचनाएं</string>
    <string name="check_notifications_desc">जन्मदिन की रोज़ की सूचना और कैलेंडर रिमाइंडर के लिए ज़रूरी है.</string>
    <string name="check_exact_alarm_title">सटीक समय पर अलार्म और रिमाइंडर</string>
    <string name="check_exact_alarm_desc">ताकि रोज़ की सूचना ठीक सेट किए गए समय पर आए. इस अनुमति के बिना इसमें थोड़ी देर हो सकती है.</string>
    <string name="check_battery_title">बैटरी ऑप्टिमाइज़ेशन बंद करें</string>
    <string name="check_battery_desc">Android को बैकग्राउंड सिंक टालने या रोकने से बचाता है.</string>
    <string name="check_background_title">बैकग्राउंड गतिविधि की अनुमति है</string>
    <string name="check_background_desc">बैकग्राउंड में ऐप्लिकेशन पर पाबंदी नहीं होनी चाहिए (ऐप्लिकेशन की जानकारी → बैटरी → “बिना पाबंदी के”).</string>
    <string name="check_hibernation_title">इस्तेमाल न होने पर ऐप्लिकेशन रोकना बंद है</string>
    <string name="check_hibernation_desc">वरना कुछ महीनों तक ऐप्लिकेशन न खोलने पर Android अनुमतियां हटा देता है और सिंक रुक जाता है.</string>
    <string name="check_power_save_title">बैटरी सेवर</string>
    <string name="check_power_save_on">बैटरी सेवर चालू है और इससे सिंक में देरी हो सकती है.</string>
    <string name="check_power_save_off">बैटरी सेवर बंद है.</string>
    <string name="check_vendor_title">डिवाइस बनाने वाली कंपनी का बैटरी मैनेजमेंट (%1$s)</string>
    <string name="check_vendor_desc">यह कंपनी अक्सर बैकग्राउंड ऐप्लिकेशन को अलग से भी बंद कर देती है. कृपया Birthday Sync के लिए ऑटो-स्टार्ट या “बैकग्राउंड में चालू रखें” की अनुमति दें. इसकी जांच अपने-आप नहीं की जा सकती.</string>

